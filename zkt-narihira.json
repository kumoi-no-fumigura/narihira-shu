 "translation": "",
 "blocks": [
  {
   "id": "zkt-narihira-0001",
   "pid": "873676",
   "pages": [
    8
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "一百其弓いつもの山の常磐なる命かあやな戀つゝ有む",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-narihira-0002",
   "pid": "873676",
   "pages": [
    8
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "げけが家にあれ感はめや足引の山掻曇り雪はとと",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-narihira-0003",
   "pid": "873676",
   "pages": [
    8
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "三小夜更て見つゝや行かむ松浦なる小夜姫の子がひれ振の山",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-narihira-0004",
   "pid": "873676",
   "pages": [
    8
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "世中中に絕て櫻のなかりせば春の心はのどけからゝゅし",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-narihira-0005",
   "pid": "873676",
   "pages": [
    8
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "平今日こやば明日は雪とそ〓なまし消すは有り共花と見ましや",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-narihira-0006",
   "pid": "873676",
   "pages": [
    8
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "移植ば秋なき時や咲ざらむ花こそ散め根さへ枯めや",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-narihira-0007",
   "pid": "873676",
   "pages": [
    8
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "セ濡つゝぞ强て折つる藤の花春は今日をし限と思へば",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-narihira-0008",
   "pid": "873676",
   "pages": [
    8
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "秋萩を色どる風は早くとも心は吹かじ草葉ならねど",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-narihira-0009",
   "pid": "873676",
   "pages": [
    8
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "24千早ぶる神代もきかず龍田がはから紅に水括るとは",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-narihira-0010",
   "pid": "873676",
   "pages": [
    8
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "〓見ずも非すみもせぬ人の戀しくは文なく今日や詠暮さむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-narihira-0011",
   "pid": "873676",
   "pages": [
    8
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "一起もせず寢もせで夜を明しては春の物とて詠幕しつ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-narihira-0012",
   "pid": "873676",
   "pages": [
    8
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "ニジンみみ袖ははひづらめ淚川身さへ流ると聞かば賴まむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-narihira-0013",
   "pid": "873676",
   "pages": [
    8
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "〓〓ぬぬ夜夜夢夢夢夢のはを睡めば彌はかなにも成增哉",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-narihira-0014",
   "pid": "873676",
   "pages": [
    8
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "大部と名にこそ立てれ流ても遂に寄潮は有りてふ物を",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-narihira-0015",
   "pid": "873676",
   "pages": [
    8
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "月や非ぬ春や昔の春ならぬ我身一つは元の身にして",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-narihira-0016",
   "pid": "873676",
   "pages": [
    8
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "An宵の間にはや愚めよ石上ふりにし床も打ち拂ふべく",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-narihira-0017",
   "pid": "873676",
   "pages": [
    8
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "一伊伊の海に浮ぶ類とも成にしが波掻分てみるめ潜かむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-narihira-0018",
   "pid": "873676",
   "pages": [
    8
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "春日野のわか紫のすり衣信夫の亂れかぎり知られず",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-narihira-0019",
   "pid": "873676",
   "pages": [
    8
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "秋秋の野に笹分し朝の袖よりも逢でこし夜ぞひぢ增ける",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-narihira-0020",
   "pid": "873676",
   "pages": [
    8
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "ce今迄に忘れぬ人は世にも有じ己が樣々年の經ぬれば",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-narihira-0021",
   "pid": "873676",
   "pages": [
    8
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "一數數ににひひ思はずとひ難み身を知る雨は降ぞ增れる",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-narihira-0022",
   "pid": "873676",
   "pages": [
    8
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "三かきくらす心の間に感ひにき夢現とはよひと定めよ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-narihira-0023",
   "pid": "873676",
   "pages": [
    8
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "三人知れぬ我が通路の關守は宵々每にうちも寢なゝむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-narihira-0024",
   "pid": "873676",
   "pages": [
    8
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "出てくる跡だに未變らぬに誰が通路と今はなるらむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-narihira-0025",
   "pid": "873676",
   "pages": [
    8
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "厭てば何か別の惜からむ有りしに勝る今日は悲しも",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-narihira-0026",
   "pid": "873676",
   "pages": [
    8
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "な他なくにまだきも月の隱るか山端逃て入れずもあらなむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-narihira-0027",
   "pid": "873676",
   "pages": [
    8
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "ゴ大方は月をもめでしこれぞ此積れば人の老となる物",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-narihira-0028",
   "pid": "873676",
   "pages": [
    8
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "〓m原原小鹽の山も今日こそは神代の事も思出づらめ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-narihira-0029",
   "pid": "873676",
   "pages": [
    8
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "今ぞ知る苦しき物と人待む里をば枯ず訪ふべかり兒",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-narihira-0030",
   "pid": "873676",
   "pages": [
    8
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "○住住びび今は限と山里に身を隱すべき宿もとめてむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-narihira-0031",
   "pid": "873676",
   "pages": [
    8
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "晴るゝ夜の星か河べの益かも我住む方の額の焚火か",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-narihira-0032",
   "pid": "873676",
   "pages": [
    8
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "三大井河浮ぶ戦舟の篝火に小倉の山も名のみなりけり",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-narihira-0033",
   "pid": "873676",
   "pages": [
    8
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "忘れては夢かとぞ思ふ思きや雪踏分て君を見むとは",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-narihira-0034",
   "pid": "873676",
   "pages": [
    8
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "世中にさらぬ別の無もがな千代もと祈る人の子の爲",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-narihira-0035",
   "pid": "873676",
   "pages": [
    8
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "1年だにも十とて四はへにけるを幾度人を賴みきぬ覧",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-narihira-0036",
   "pid": "873676",
   "pages": [
    8
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "背くとて雲には乘ぬ物なれど世の憂事ぞよそに成てふ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-narihira-0037",
   "pid": "873676",
   "pages": [
    8
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "紫の色濃き時はめも遙に野なる草木ぞ分れざりける",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-narihira-0038",
   "pid": "873676",
   "pages": [
    8
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓白玉のまなくも散か袖の狹きに",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-narihira-0039",
   "pid": "873676",
   "pages": [
    8
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "年年へへ住にし里を出ていなば最ど深草のとや成なむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-narihira-0040",
   "pid": "873676",
   "pages": [
    8
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "0○〓時知ぬ山は富士のねいつとてか鹿子班に雪の降らむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-narihira-0041",
   "pid": "873676",
   "pages": [
    8
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "一幕のとて寢て行べくも非なくに泣々も狩歸る勝れり",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-narihira-0042",
   "pid": "873676",
   "pages": [
    8
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "ニ屬なきて菊の花咲く秋はあれど春は海べに住吉の濱",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-narihira-0043",
   "pid": "873676",
   "pages": [
    8
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "難波江を今日社みつの浦に住む是や此よを憂み渡る舟",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-narihira-0044",
   "pid": "873676",
   "pages": [
    8
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "唐衣きつゝ馴れにし妻し有れば遙々きぬる旅をしぞ思",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-narihira-0045",
   "pid": "873676",
   "pages": [
    8
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "名にしおはゞいざ當間む都鳥我思ふ人は有や無やと",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-narihira-0046",
   "pid": "873676",
   "pages": [
    8
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓らむ天の河原に我はきにけり",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-narihira-0047",
   "pid": "873676",
   "pages": [
    8
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "長行歸り空にのみしてふる〓とは我居る山の風早みなり",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-narihira-0048",
   "pid": "873676",
   "pages": [
    8
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "〓終に行道とは兼て聞しかど昨日今日とは思ざりしを",
   "sachu": "",
   "poems": [],
   "jo": ""
  },
  {
   "id": "zkt-narihira-0049",
   "pid": "873676",
   "pages": [
    8
   ],
   "no": null,
   "kotobagaki": "",
   "author": "",
   "text": "〓〓めつゝあはで年ふる僞にこりぬ心を人は知らなむ",
   "sachu": "",
   "poems": [],
   "jo": ""
  }
 ],
